  // Emoticons like >.> and :) can stay as they are.
  // ---------------------------------------------------------------
  "CHAT_ME": "Me",
  "CHAT_STEPHANIE": "Stephanie",
  "CHAT_USER_IS_ONLINE": "This user is now online.",
  "CHAT_USER_IS_OFFLINE": "This user is offline.",

