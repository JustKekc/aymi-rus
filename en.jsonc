  // College chat.
  "CHAT_COLLEGE_IVE_BEEN_THINKING_OF_THAT_GAME": "steph! i've been thinking of that game we used to play.",
  "CHAT_COLLEGE_AHH_YES_IVE_BEEN_THINKING_OF_IT_TOO": "ahh yes, i've been thinking of it too",
