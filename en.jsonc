  // The scar
  // The first two are the player's voice, the rest is the therapist.
  // ---------------------------------------------------------------
  "SCAR_I_REMEMBER": ["I remember when I got this scar on my hand."],
  "SCAR_WHEN_I_SEE_IT": [
    "When I see it,",
    "I am reminded of that moment.",
    "As if the memory pierces through time."
  ],
  "SCAR_THE_EMPTINESS": [
    "The emptiness you feel is as real",
    "as the scar on your hand."
  ],
  "SCAR_STRETCHING_BACK": ["Stretching back towards childhood."],
  "SCAR_PAIN_REPEATS": [
    "Pain repeats and flows.",
    "From one person to the next."
  ],
  "SCAR_UNFORTUNATE_RESPONSIBILITY": [
    "It is an unfortunate responsibility",
    "to stop the flow of pain."
  ],
  "SCAR_YOU_ALONE": ["But you alone make that choice."],
