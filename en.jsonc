  // ---------------------------------------------------------------
  // Therapy
  // ---------------------------------------------------------------
  "THERAPY_WHERE_ARE_YOU_NOW": ["Where are you now?"],
  // The player's voice.
  "THERAPY_ISNT_THIS_ME": [
    "Isn't this me?",
