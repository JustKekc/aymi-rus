  // Teenager chat 2, on a messenger.
  "CHAT_TEENAGER2_DO_YOU_REMEMBER_THAT_GAME": "steph!! do you remember that game we used to play??",
  "CHAT_TEENAGER2_YEAH_DO_YOU_WANT_TO_HOP_ON": "YEAH!! do you want to hop on?",
  "CHAT_TEENAGER2_ITS_STILL_UP": "it's still up ??",
