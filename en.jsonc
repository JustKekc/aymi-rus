  // Teenager chat, still inside the pet game.
  "CHAT_TEENAGER_HAVENT_SEEN_U_IN_A_WHILE": "havent seen u in a while!",
  "CHAT_TEENAGER_OMG_YES_HOW_ARE_U": "omg yes how are u",
