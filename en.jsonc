  "MEMORIAL_REMEMBERING": "Remembering",
  "MEMORIAL_NAME": "Stephanie Huynh",
  "MEMORIAL_YEARS": "1998 - 2023",

  // ---------------------------------------------------------------
  // Time passing. Each line is its own screen.
  // ---------------------------------------------------------------
  "TIME_PASSING": [
    "I am staring out my office window.",
    "I am at my best friend's wedding.",
    "I am celebrating my 24th birthday.",
    "I just broke up.",
    "I am holding my friend's baby.",
    "I am celebrating my 25th birthday.",
    "I just moved cities.",
    "I am celebrating my 29th birthday.",
    "Why do all the days blend together?"
  ],
  // "Why does time keep moving?" shown one word per screen, faster
  // and faster. You can split your sentence into more or fewer
  // pieces, each entry is its own screen.
  "WHY_DOES_TIME_KEEP_MOVING": [
    "Why",
    "Does",
    "Time",
    "Keep",
    "Moving?"
  ],

  // ---------------------------------------------------------------
  // Slowing down
  // The first half is the therapist's voice.
  // The second half (shown in blue italics) is the player's voice.
  // ---------------------------------------------------------------
  "SLOW_DOWN_THERAPIST": [
    "Slow down.",
    "Keep Pushing. Don't Let Go.",
    "Breathe.",
    "In.",
    "Out.",
    "How are you feeling?",
    "Frustration?",
    "Anxiety?",
    "Apathy?"
  ],
  // This is one long thought broken up across screens, so the last
  // two entries are one sentence split in half.
  "SLOW_DOWN_ME": [
    "I guess I feel...",
    "Loneliness.",
    "Like there’s a weirdly shaped hole in my body.",
    "And I try to fill it up with hobbies, people, things.",
    "But none of them fit.",
    "They seem to fit at first, and I try to force them in but I eventually cause pain.",
    "I keep going back to old memories.",
    "Old video games.",
    "When time seemed to stretch infinitely in both directions,",
    "and the days lasted forever."
  ],
  "PERMISSION_TO_FEEL_SAD": "I give myself permission to feel sad.",
  "PERMISSION_TO_FEEL_HAPPY": "I give myself permission to feel happy.",

