  // College chat 2. They are drifting apart.
  "CHAT_COLLEGE2_HEY_STEPH_YEARLY_CHAT": "Hey steph :) yearly chat?",
  "CHAT_COLLEGE2_SURE_HOW_ARE_U_DOING": "sure... how are u doing?",
