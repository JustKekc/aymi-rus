// I've documented a couple things here.
// You don't have to translate everything, but I included
// as much as I can just in case.
//
// {0}, {1}, ... are placeholders that the game fills in (a button icon,
// a name, a link). Keep them in the sentence, but move them wherever
// your language needs them.
//
// Text with multiple lines is written as a list surrounded by [] brackets,
// one entry per line.
// An empty entry ("") is a blank line between paragraphs.
{
  "NAME": "English",
  "FONT_FAMILY": "Pixelated Times New Roman",
  "CONTINUE_BUTTON": "Continue",

  // ---------------------------------------------------------------
  // Language menu
  // ---------------------------------------------------------------
  "LANGUAGE_MENU_TITLE": "Language",
  // {0} is the link below (LANGUAGE_MENU_NOTE_LINK).
  "LANGUAGE_MENU_NOTE": "Note: These are community translations and may not be completely accurate. If you want to contribute or make corrections, join our {0}.",
  // Don't translate "Discord". Kept here for consistency.
  "LANGUAGE_MENU_NOTE_LINK": "Discord",

  // ---------------------------------------------------------------
  // Title screen, warning, shared buttons
  // ---------------------------------------------------------------
  // Shown right after the button icon on the title screen.
  "START_BUTTON": "start",
  "WARNING": "Warning: This game contains mature content that may be disturbing and unsuitable for children.",
  "WARNING_CONTINUE": "continue",
  "WARNING_EXIT": "exit",
  // The default button under most narration.
  "BLINK_BUTTON": "blink",
  // {0} is the button icon.
  "PRESS_TO_BLINK_BUTTON": "press {0} to blink",
  "END_CALL_BUTTON": "end call",
  "RESTART_POPUP": "Hold \"START\" button for 5 seconds to restart.",

  // ---------------------------------------------------------------
  // Control tutorial
  // ---------------------------------------------------------------
  // {0} is the button icon.
  "TUTORIAL_GRAB": "Use {0} to grab.",
  "TUTORIAL_GRAB_PS3": "Use the L2 or R2 triggers to grab.",
  "TUTORIAL_GRAB_GAMECUBE": "Use the L or R triggers to grab.",
  "TUTORIAL_GRAB_RELEASE": "Release {0} to stop grabbing.",
  "TUTORIAL_GRAB_RELEASE_GAMEPAD": "Release the L or R trigger to stop grabbing.",
  "TUTORIAL_MOVE": "Use {0} to move.",
  "TUTORIAL_MOVE_GAMEPAD": "Use the analog stick to move.",

  // ---------------------------------------------------------------
  // Hover text: the small label shown when the hand is over something.
  // ---------------------------------------------------------------
  "HOVER_THOUGHT": "a thought",
  "HOVER_MEMORY": "a memory",
  "HOVER_PENCIL": "a pencil",
  "HOVER_CUBE": "a cube",
  "HOVER_SPHERE": "a sphere",
  "HOVER_CONE": "a cone",
  "HOVER_DOCUMENT": "a document",
  "HOVER_RESUME": "a resume",
  "HOVER_CONTINUE": "continue",
  "HOVER_COLOR_BLACK": "black",
  "HOVER_COLOR_WHITE": "white",
  "HOVER_COLOR_RED": "red",
  "HOVER_COLOR_YELLOW": "yellow",
  "HOVER_COLOR_GREEN": "green",
  "HOVER_COLOR_CYAN": "cyan",
  "HOVER_COLOR_BLUE": "blue",
  "HOVER_COLOR_PINK": "pink",
  // Backpack stickers.
  "HOVER_STICKER_PLUSHIE": "plushie",
  "HOVER_STICKER_SMILEY": "smiley",
  "HOVER_STICKER_MUSTACHE": "mustache",
  // Optional: Made up font names for the resume
  // (Arial/Helvetica, Times New Roman, Open Sans/Droid).
  "HOVER_FONT_ARIAVETICA": "ariavetica",
  "HOVER_FONT_TIMES_OLD": "times old",
  "HOVER_FONT_OPEN_DROID": "open droid",
  // Optional: Made up creature names for the avatar (fish, rabbit, chao).
  "HOVER_CREATURE_FISHEE": "fishee",
  "HOVER_CREATURE_ROBBIT": "robbit",
  "HOVER_CREATURE_CHIO": "chio",

  // ---------------------------------------------------------------
  // Opening
  // ---------------------------------------------------------------
  "I_AM_ON_A_TRAIN": [
    "I am on a train,",
    "going from one point to the next.",
    "",
    "Sometimes it stops and",
    "I take in the view.",
    "",
    "Other times, it feels like",
    "it just keeps moving."
  ],

  // ---------------------------------------------------------------
  // Thoughts: short lines that float around and get dragged away.
  // They are drawn on a small single-line sign, so keep them short.
  // All lowercase on purpose.
  // ---------------------------------------------------------------
  "THOUGHTS_INSTRUCTION": "Drag the thoughts away to wake up.",
  "THOUGHTS_BABY": [
    "why is the sky blue?",
    "where is my mom?",
    "i am hungry"
  ],
  "THOUGHTS_TEENAGER": [
    "do they like me?",
    "what's due tomorrow?",
    "i wonder what she thinks of me.",
    "why do i feel so different"
  ],
  "THOUGHTS_ADULT": [
    "what am i doing with my life?",
    "do my coworkers like me?",
    "what happens after we die?",
    "what day of the week is it?",
    "do i like what i'm doing?",
    "is this forever?",
    "will i regret this?",
    "should i break up?",
    "i feel empty",
    "i feel like I'm doing this alone",
    "why am i so anxious"
  ],

  // ---------------------------------------------------------------
  // Childhood
  // ---------------------------------------------------------------
  "FIRST_MEMORY": [
    "The first memory I ever had",
    "was of three women",
    "looking down at me.",
    "",
    "They poked at my face."
  ],
  "DRAWING_KIDS_DONE": "I like the way the pencil feels against the paper.",
  "DRAWING_TEENAGER_DONE": "It's easy when there's guidance.",
  "DRAWING_COLLEGE_DONE": "I can't do this.",
  "SHAPES_KIDS_CUBE": "I like how it feels in my hand.",
  "SHAPES_KIDS_SPHERE": "A little stuck, but it's okay.",
  "SHAPES_KIDS_CONE": "It pokes my hand as I push it through.",
  // The top line and bottom line are shown at the top and bottom of the screen.
  "BLINK_FORCE_THE_SHAPE_IN": "I force the shape in.",
  "BLINK_IT_PINCHES": "It pinches and cuts my hand.",

  // ---------------------------------------------------------------
  // Chats
  // The way they type grows up with them: kid chatspeak with typos
  // ("any1", "wat r ur"), then teenager, then college, then formal
