  // Each thought is dragged away, then its response is shown.
  // Some of the thoughts are repeated from THOUGHTS_ADULT.
  // Thoughts are drawn on a small single-line sign, so keep them short.
  "THERAPY_THOUGHT_1": "I am worthless",
  "THERAPY_RESPONSE_1": "do I accept this thought?",
  "THERAPY_THOUGHT_2": "do my coworkers like me?",
  "THERAPY_RESPONSE_2": "it's okay to worry about my relationships",
  "THERAPY_THOUGHT_3": "what day of the week is it?",
  "THERAPY_RESPONSE_3": "can't always be on top of everything",
  "THERAPY_THOUGHT_4": "do I like what i'm doing?",
  "THERAPY_RESPONSE_4": "i'll take time to reflect",
  "THERAPY_THOUGHT_5": "is this forever?",
