  "CHAT_COLLEGE2_THATS_GOOD": "that's good",

  // Work chat with a coworker. Formal, proper punctuation.
  "CHAT_WORK_NAME": "Robert Tsang",
  "CHAT_WORK_I_AM_CURRENTLY_BLOCKED": "Hey. I am currently blocked by the interface you are designing. When do you think it will be done by?",
  "CHAT_WORK_OH_HEY_SORRY_ABOUT_THAT": "Oh hey! Yeah sorry about that, I am still working on it. I will let you know when it's done. So sorry for the inconvenience.",
  "CHAT_WORK_THE_TEAM_NEEDS_A_BETTER_TIME_ESTIMATE": "Yeah, it's just the team needs a better time estimate so that we can prioritize tasks.",
  "CHAT_WORK_HOW_ABOUT_NEXT_THURSDAY": "Ok... How about... Next Thursday?",
